# Local development placeholders; replace with authorized values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public e-Mola receiving information shown to users (never put secrets here).
NEXT_PUBLIC_EMOLA_NUMBER=
NEXT_PUBLIC_EMOLA_MERCHANT_NAME=

# Optional e-Mola provider API credentials (server-side only).
EMOLA_API_URL=
EMOLA_MERCHANT_ID=
EMOLA_API_KEY=
EMOLA_WEBHOOK_SECRET=

# Set to true only in a protected non-production environment.
PRIVATE_TEST_MODE=false
NEXT_PUBLIC_PRIVATE_TEST_MODE=false
